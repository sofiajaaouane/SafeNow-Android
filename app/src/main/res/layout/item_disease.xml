<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/input_modern_background"
    android:layout_marginBottom="8dp"
    android:paddingStart="14dp"
    android:paddingEnd="8dp">

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_blood"
        android:alpha="0.4"
        android:contentDescription="@null" />

    <EditText
        android:id="@+id/etDiseaseName"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:hint="@string/hint_disease"
        android:textSize="14sp"
        android:paddingStart="10dp"
        android:background="@null"
        android:textColor="#212121"
        android:textColorHint="#BDBDBD" />

    <ImageButton
        android:id="@+id/btnRemoveDisease"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_delete"
        android:contentDescription="@string/btn_remove_disease"
        android:background="@drawable/btn_delete_disease_bg"
        android:tint="#EF5350"
        android:padding="6dp" />

</LinearLayout>