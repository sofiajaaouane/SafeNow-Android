<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_bg"
    android:padding="24dp"
    tools:ignore="HardcodedText,SmallSp">

    <!-- ── TOP ROW: avatar + title + toggle ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tvPopupGroupAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="G"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/step_circle_active" />

        <TextView
            android:id="@+id/tvPopupGroupName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Groupe"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginHorizontal="12dp" />

        <Switch
            android:id="@+id/switchActivateGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            tools:ignore="UseSwitchCompatOrMaterialCode,TouchTargetSizeCheck" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/llPopupMembers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/btnAddMember"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/btn_outline_red"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="+"
            android:textColor="#CC0000"
            android:textSize="22sp"
            tools:ignore="TouchTargetSizeCheck" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llPopupMembersAvatars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

        </HorizontalScrollView>

    </LinearLayout>

    <!-- Hint -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Appui long pour retirer un membre (ou via +)"
        android:textSize="11sp"
        android:textColor="#BBBBBB"
        android:layout_marginBottom="24dp" />

    <!-- ── SOS BUTTON ── -->
    <FrameLayout
        android:id="@+id/btnSOS"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/circle_ring_outer"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="138dp"
            android:layout_height="138dp"
            android:layout_gravity="center"
            android:background="@drawable/circle_ring_mid">

            <FrameLayout
                android:layout_width="116dp"
                android:layout_height="116dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_sos_button">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_shield_heartbeat_red"
                        android:layout_marginBottom="2dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SOS"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aide immediate"
                        android:textColor="#FFCCCC"
                        android:textSize="8sp" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>


    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginBottom="16dp" />

    <!-- Delete button -->
    <TextView
        android:id="@+id/btnDeleteGroup"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Supprimer le groupe"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#CC0000"
        android:gravity="center"
        android:background="@drawable/btn_outline_red"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>