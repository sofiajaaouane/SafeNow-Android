<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="180dp">

        <!-- Solid red background -->
        <View
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#CC0000" />


        <ImageView
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_alignParentBottom="true"
            android:src="@drawable/header_curve"
            android:scaleType="fitXY" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/signup_title"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.12" />
    </RelativeLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="40dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">


        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="1"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/step_circle_active" />

        <!-- Connector line -->
        <View
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="#E0E0E0"
            android:layout_marginHorizontal="8dp" />


        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="2"
            android:textSize="17sp"
            android:textColor="#CCCCCC"
            android:gravity="center"
            android:background="@drawable/step_circle_inactive" />

        <View
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="#E0E0E0"
            android:layout_marginHorizontal="8dp" />


        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="3"
            android:textSize="17sp"
            android:textColor="#CCCCCC"
            android:gravity="center"
            android:background="@drawable/step_circle_inactive" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="4dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/signup_phone_number"
            android:textSize="10sp"
            android:textColor="#999999"
            android:letterSpacing="0.1"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="120dp"
                android:layout_height="54dp"
                android:orientation="horizontal"
                android:background="@drawable/input_field_bg"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="4dp"
                android:layout_marginEnd="10dp">


                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_flag_globe"
                    android:layout_marginEnd="6dp" />

                <Spinner
                    android:id="@+id/spinnerCountryCode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:spinnerMode="dropdown" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:background="@drawable/input_field_bg"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_phone_outline"
                    android:layout_marginEnd="10dp" />

                <EditText
                    android:id="@+id/etPhoneNumber"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/signup_hint_digits_9"
                    android:inputType="number"
                    android:maxLength="9"
                    android:textSize="15sp"
                    android:textColor="#222222"
                    android:textColorHint="#BBBBBB" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingBottom="36dp"
        android:paddingTop="12dp">


        <TextView
            android:id="@+id/tvLogin"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/signup_login"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#CC0000"
            android:gravity="center"
            android:background="@drawable/btn_outline_red"
            android:layout_marginEnd="14dp" />


        <TextView
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/signup_next"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/btn_red_rounded" />
    </LinearLayout>

</LinearLayout>